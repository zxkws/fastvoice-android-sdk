[binaries]
c = '@TOOLCHAIN_DIR@/bin/aarch64-linux-android23-clang'
cpp = '@TOOLCHAIN_DIR@/bin/aarch64-linux-android23-clang++'
ar = '@TOOLCHAIN_DIR@/bin/llvm-ar'
strip = '@TOOLCHAIN_DIR@/bin/llvm-strip'

[host_machine]
system = 'android'
cpu_family = 'aarch64'
cpu = 'armv8-a'
endian = 'little'

[built-in options]
buildtype = 'release'
default_library = 'shared'
c_args = ['-fPIC']
cpp_args = ['-fPIC']
# Keep ELF LOAD segments compatible with Android devices using 16 KB pages.
c_link_args = ['-Wl,-z,max-page-size=16384']
cpp_link_args = ['-Wl,-z,max-page-size=16384']
